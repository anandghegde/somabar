# Copy to Config/release.local.env (ignored by git). Scripts/release.sh sources it; values
# already set in the environment win. Every entry is optional: without one, its step is
# skipped with a note.

# Developer ID signing. Without it the release is ad-hoc signed and cannot be notarized.
# `security find-identity -v -p codesigning` lists what the keychain holds.
# SOMABAR_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"

# Notarization: a notarytool keychain profile, made once with
#   xcrun notarytool store-credentials somabar-notary --apple-id you@example.com --team-id TEAMID1234
# SOMABAR_NOTARY_PROFILE=somabar-notary

# Sparkle signing key: by default generate_appcast reads it from the login keychain. Point
# this at an exported key file instead (CI does).
# SPARKLE_ED_KEY_FILE=/path/to/sparkle_private_key

# Build a .dmg next to the .zip (1) or not (0).
# SOMABAR_DMG=1
