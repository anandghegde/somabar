{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "~/bin/somabar-agent-hook.sh working" }] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "~/bin/somabar-agent-hook.sh working" }] }
    ],
    "PermissionRequest": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "~/bin/somabar-agent-hook.sh ask", "timeout": 90 }] }
    ],
    "Notification": [
      { "hooks": [{ "type": "command", "command": "~/bin/somabar-agent-hook.sh needsYou" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "~/bin/somabar-agent-hook.sh done" }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "~/bin/somabar-agent-hook.sh ended" }] }
    ]
  }
}
